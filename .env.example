# ── Database ─────────────────────────────────────────────
# Neon PostgreSQL connection string. Required for db/index.ts and any
# API route that persists data. Not required to run the UI with demo data.
DATABASE_URL=
# ── Maps ─────────────────────────────────────────────────
# Public Google Maps API key (optional). If provided, high-resolution Google Maps,
# Google Satellite (hybrid), and Google Terrain tile layers will be used.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── ML Service ───────────────────────────────────────────
# Base URL of the FastAPI risk service (see ml-service/). If unset, the
# frontend falls back to a clearly-marked development mock predictor.
# Example: http://localhost:8000
ML_SERVICE_URL=

# ── Weather ──────────────────────────────────────────────
# Optional. The default provider (Open-Meteo) needs no key. Set this only
# if you swap in a key-based provider in lib/weather/provider.ts.
WEATHER_API_KEY=    

# ── Satellite / NDVI ─────────────────────────────────────
# Sentinel Hub (or equivalent) OAuth credentials. Until set, NDVI shows
# "Data source not configured" instead of fabricated values.
SATELLITE_CLIENT_ID=
SATELLITE_CLIENT_SECRET=

# ── Gemini AI ─────────────────────────────────────────────
# Required for AI-powered personalized crop guidance advisory
GEMINI_API_KEY=
